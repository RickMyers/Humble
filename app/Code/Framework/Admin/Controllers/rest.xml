<?xml version="1.0"?>
<!--

REST Testing App

For Controller reference, please see "Anatomy of a Controller" at https://www.humbleprogramming.com/pages/Controllers.htmls
-->
<controller name="rest" use="Twig" author="Rick Myers" email="rick@humbleprogramming.com">
    <actions blocking="off" response="false">
        
        <action name="app" passalong="window_id">
            <description>Main app page</description>
        </action>    

        <!-- ############################################################### -->

        <action name="namespaces" response="true" output='JSON'>
            <description>Lists active namespaces for the rest client</description>
            <entity namespace='humble' class='modules' fields="namespace" method="fetch" orderby="namespace=ASC">   
                <parameter name="enabled" source="request" default='Y' />
            </entity>
        </action>
        
        <!-- ############################################################### -->
        
        <action name="controllers" output="JSON" response="true">
            <description>Gets a list of controllers within a certain namespace</description>
            <helper namespace="admin" class="rest/client" method="listControllers" wrapper="json_encode">
                <parameter name="namespace" source="request" required="true" />
            </helper>
        </action>
        
        <!-- ############################################################### -->

        <action name="actions">
            <description>Gets a list of actions within a controller</description>
        </action>

        <!-- ############################################################### -->
        
        <action name="parameters">
            <description>Gets a list of parameters used by an action</description>
        </action>
        
    </actions>
</controller>