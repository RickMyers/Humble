<div id="win_{{window_id}}_header" class="text-right font-mono p-1" style="background-color: #333; color: ghostwhite">
    {{ serial_number }}
</div>
<div id="win_{{window_id}}_body"   class="" style="">
    Body
</div>
<div id="win_{{window_id}}_footer" class="text-right font-mono p-1" style="background-color: #333; color: ghostwhite">
    &copy; 2007-present, Humbleprogramming.com
</div>
<script type="text/javascript">
    (($) => {
        let win    = Desktop.window.list['{{ window_id }}'];
        let header = $('#win_{{ window_id }}_header').get();
        let body   = $('#win_{{ window_id }}_body').get();
        let footer = $('#win_{{ window_id }}_footer').get();
        win.resize((evt) => {
            $(body).height(win.content.height() - $(header).height() - $(footer).height() - 4);
        });
    })($);
</script>