<style type="text/css">
    .zebra-table tr:nth-child(even) {
      background-color: #dadada;
    }
    .zebra-row {
         border: 1px solid transparent; opacity: .75
    }
    .zebra-row:hover {
        opacity: 1.0; border: 1px solid #777
    }
    .text-cell:hover {
        border: 1px solid #777
    }
</style>
<div id='entity_area_{{ window_id }}_{{ tab_id }}' class="entity_area_{{ window_id }}_{{ tab_id }}">
</div>        
<script type="text/javascript">
    Humble.admin['entity'] = (!Humble.admin['entity']) ? {} : Humble.admin['entity'];
    Humble.admin['query']  = (!Humble.admin['query'])  ? {} : Humble.admin['query'];
    ((win)=> {
        win.title('Entity Explorer');        
        let explorer_nav    = $('#entity_explorer_nav_{{ window_id }}').height();
        let entity_area     = $('.entity_area_{{ window_id }}_{{ tab_id }}').get(0);
        Humble.admin['entity']['{{ window_id }}_{{ tab_id }}'] = Vue.createApp({
            template:   Humble.template('admin',"entity/list",true),
            app:        null,
            data() {
                return {
                    window_id:      '{{ window_id }}',
                    tab_id:         '{{ tab_id }}',
                    win:            Desktop.window.list['{{ window_id }}'],
                    explorer_form:  'entity_explorer_form_{{ window_id }}_{{ tab_id }}',
                    tabs:           false,
                    header:         false,
                    controls:       false,
                    query_text:     false,
                    query_area:     false,
                    context:        {},
                    edit_context:   false,
                    footer:         0,
                    title:          0,
                    elements: {
                        context:        'context_{{ window_id }}_{{ tab_id }}',
                        header:         'header_{{ window_id }}_{{ tab_id }}',
                        controls:       'query_controls_{{ window_id }}_{{ tab_id }}',  
                        nav:            'entity_query_nav_{{ window_id }}_{{ tab_id }}',
                        query:          'query_{{ window_id }}_{{ tab_id }}',
                        query_text:     'query_textarea_{{ window_id }}_{{ tab_id }}'
                    },
                    list: {
                        tab:        'list_tab_{{ window_id }}_{{ tab_id }}',
                        area:       'entity_list_{{ window_id }}_{{ tab_id }}',                
                        footer:     'entity_footer_{{ window_id }}_{{ tab_id }}',
                        title:      'entitytitle_{{ window_id }}_{{ tab_id }}',
                        headers:    [],
                        entities:   [],
                        page:       1,
                        pages:      0,
                        rows:       20,
                        fromRow:    1,
                        toRow:      1,
                        totalRows:  0
                    },
                    econtent: {
                        entity:     null,
                        table:      null,
                        namespace:  null,
                        tab:        'content_tab_{{ window_id }}_{{ tab_id }}',
                        area:       'content_area_{{ window_id }}_{{ tab_id }}',                
                        footer:     'content_footer_{{ window_id }}_{{ tab_id }}',
                        title:      'contenttitle_{{ window_id }}_{{ tab_id }}',
                        headers:    [],
                        data:       [],
                        page:       1,
                        pages:      0,
                        rows:       20,
                        fromRow:    1,
                        toRow:      1,
                        totalRows:  0
                    },
                    edit: {
                        tab:        'edit_tab_{{ window_id }}_{{ tab_id }}',
                        footer:     'edit_footer_{{ window_id }}_{{ tab_id }}',
                        area:       'edit_area_{{ window_id }}_{{ tab_id }}',
                        title:      'edittitle_{{ window_id }}_{{ tab_id }}',
                        form:       'explorer_edit_form_{{ window_id }}_{{ tab_id }}',
                        fields:     [],
                        id:         0,
                    }, 
                    query: {
                        tab:        'query_tab_{{ window_id }}_{{ tab_id }}',
                        footer:     'query_footer_{{ window_id }}_{{ tab_id }}',
                        title:      'querytitle_{{ window_id }}_{{ tab_id }}',
                        results:    'query_results_{{ window_id }}_{{ tab_id }}',
                        area:       'query_area_{{ window_id }}_{{ tab_id }}',
                        edittab:    'query_edit_tab_{{ window_id }}_{{ tab_id }}',   
                        edittitle:  'query_edittitle_{{ window_id }}_{{ tab_id }}',   
                        editarea:   'query_edit_area_{{ window_id }}_{{ tab_id }}',
                        editfooter: 'query_edit_footer_{{ window_id }}_{{ tab_id }}',
                        headers:    [],
                        resultset:  [],
                        edit: {
                            row:     []
                        },
                        page:       1,
                        pages:      0,
                        rows:       20,
                        fromRow:    1,
                        toRow:      1,
                        totalRows:  0
                    },                    
                    content:        []
                }
            },
            mounted() {
                //alert('mounted');
                this.footer     = ($('#'+this.list.footer).height() || $('#'+this.econtent.footer).height() || $('#'+this.edit.footer).height() || $('#'+this.query.footer).height()  );
                this.title      = ($('#'+this.list.title).height()  || $('#'+this.econtent.title).height()  || $('#'+this.edit.title).height() || $('#'+this.query.title).height());
                this.form       = document.getElementById(this.edit.form);
                this.header     = document.getElementById(this.elements.header);
                this.controls   = document.getElementById(this.elements.controls); 
                this.query_text = document.getElementById(this.elements.query_text);
                this.query_nav  = document.getElementById(this.elements.nav);
                this.query_area = document.getElementById(this.elements.query);
                this.results_area = document.getElementById(this.query.results);
                new ResizeObserver(this.sizeIt).observe(this.query_text);
                this.win.resize(this.sizeIt).resize();                
                this.tabs       = new EasyTab(this.elements.nav,120);                
                this.tabs.add('Entities'      ,null,this.list.tab);
                this.tabs.add('Content'       ,null,this.econtent.tab);
                this.tabs.add('Edit'          ,null,this.edit.tab);
                this.tabs.add('Query Results' ,null,this.query.tab);
                this.tabs.add('Query Edit'    ,null,this.query.edittab);
                this.tabs.tabClick(0);
                this.entities();
                this.contexts();
            },
            unmounted() {
                this.cleanup();
            },
            methods: {
                saveWorkspace(event) {
                    alert('saving workspace');
                },
                screenIt(val) {
                    if (typeof val == 'object') {
                        val= JSON.stringify(val);
                    }
                    return val;
                },
                sizeIt() {
                    let h = this.win.content.height() - this.header.offsetHeight - this.controls.offsetHeight - this.query_area.offsetHeight - explorer_nav - this.footer - this.title - 34;
                    $('#'+this.list.area).height(h);
                    $('#'+this.econtent.area).height(h);
                    $('#'+this.edit.area).height(h);
                    $('#'+this.query.results).height(h);
                    $('#'+this.query.editarea).height(h);
                },
                entityFirst() {
                    this.list.page = 1;
                    this.entities();
                },
                entityPrev() {
                    if (--this.list.page < 1) {
                        this.list.page = this.list.pages;
                    }
                    this.entities();                    
                },
                entityNext() {
                    if (++this.list.page > this.list.pages) {
                        this.list.page = 1;
                    }
                    this.entities();                    
                },
                entityLast() {
                    this.list.page = this.list.pages;
                    this.entities();                    
                },
                entityJump(evt) {
                    let page = evt.target.value;
                    if (page) {
                        this.list.page = ((page > 0) ? (page < this.list.pages ? page : this.list.pages) : 1);
                        this.entities();
                    }
                },                
                entityPagination(p) {
                    this.list.totalRows  = p.rows.total;
                    this.list.fromRow    = p.rows.from;
                    this.list.toRow      = p.rows.to;
                    this.list.page       = p.pages.current;
                    this.list.pages      = p.pages.total;
                },  
                contexts() {
                    let app = this;
                    (new EasyAjax('/admin/entity/contexts')).then((response) => {
                        if (response) {
                            let entities = JSON.parse(response);
                            let list  = [];
                            if (entities) {
                                for (let i=0; i<entities.length; i++) {
                                    list[list.length] = entities[i].namespace+'_'+entities[i].entity;
                                }
                            }
                            app.context = list;
                        }
                    }).get();
                },
                entities() {
                    let app = this;
                    var ao  = new EasyAjax('/admin/entity/list') ;
                    ao.add('page',this.list.page).add('rows',this.list.rows).add('window_id',this.window_id).then((response)=>{
                        if (response) {
                            let entities = JSON.parse(response);
                            let headers  = [];
                            for (var i in entities[0]) {
                                headers[headers.length] = i;
                            }
                            app.list.headers  = headers;
                            app.list.entities = entities;
                            app.entityPagination(ao.getPagination());
                        }
                    }).post();
                },
                contentFirst() {
                    this.econtent.page = 1;
                    this.expand();
                },
                contentPrev() {
                    if (--this.econtent.page < 1) {
                        this.econtent.page = this.econtent.pages;
                    }
                    this.expand();                    
                },
                contentNext() {
                    if (++this.econtent.page > this.econtent.pages) {
                        this.econtent.page = 1;
                    }
                    this.expand();                    
                },
                contentLast() {
                    this.econtent.page = this.econtent.pages;
                    this.expand();                    
                },
                contentJump(evt) {
                    let page = evt.target.value;
                    if (page) {
                        this.econtent.page = ((page > 0) ? (page < this.econtent.pages ? page : this.econtent.pages) : 1);
                        this.expand();
                    }
                },                
                contentPagination(p) {
                    if (p) {
                        this.econtent.totalRows  = p.rows.total;
                        this.econtent.fromRow    = p.rows.from;
                        this.econtent.toRow      = p.rows.to;
                        this.econtent.page       = p.pages.current;
                        this.econtent.pages      = p.pages.total;
                    }
                },                    
                expand(entity) {
                    if (entity) {
                        this.econtent.entity = entity;
                    }
                    let app                 = this;
                    let parts               = this.econtent.entity.split('_');
                    this.econtent.namespace = parts.shift();
                    this.econtent.table     = parts.join('_');
                    this.tabs.tabClick(1);
                    let ao = new EasyAjax('/admin/entity/content');
                    ao.add('namespace',this.econtent.namespace).add('entity',this.econtent.table).add('rows',this.econtent.rows).add('page',this.econtent.page).then((response) => {
                        let rows     = JSON.parse(response);
                        let headers  = [];
                        for (var i in rows[0]) {
                            headers[headers.length] = i;
                        }
                        app.econtent.headers = headers;
                        app.econtent.data    = rows;
                        app.contentPagination(ao.getPagination());
                    }).post();
                },
                editRow(id) {
                    let app = this;
                    app.tabs.tabClick(2);
                    this.edit.id = id;
                    (new EasyAjax('/admin/entity/edit')).add('namespace',this.econtent.namespace).add('id',id).add('entity',this.econtent.table).then((response) => {
                        app.edit.fields = JSON.parse(response);
                        //now set the form intercept
                        //Form.intercept(Form Reference,MongoDB ID,optional URL or just FALSE,Dynamic WindowID to Close After Saving);
                        Form.intercept($('#'+app.edit.form).get(),null,'/admin/entity/updaterow',null);                        
                    }).post();
                },
                queryPagination(p) {
                    if (p) {
                        this.query.totalRows  = p.rows.total;
                        this.query.fromRow    = p.rows.from;
                        this.query.toRow      = p.rows.to;
                        this.query.page       = p.pages.current;
                        this.query.pages      = p.pages.total;
                    }
                },                  
                queryFirst() {
                    this.query.page = 1;
                    this.runQuery();
                },
                queryNext() {
                    if (++this.query.page > this.query.pages) {
                        this.query.page = 1;
                    }
                    this.runQuery();                      
                },
                queryPrev() {
                    if (--this.query.page < 1) {
                        this.query.page = this.query.pages;
                    }
                    this.runQuery();                   
                },
                queryLast() {
                    this.query.page = this.query.pages;
                    this.runQuery();                         
                },
                queryJump(evt) {
                    let page = evt.target.value;
                    if (page) {
                        this.query.page = ((page > 0) ? (page < this.query.pages ? page : this.query.pages) : 1);
                        this.runQuery();
                    }
                },
                setEditContext(evt) {
                    this.edit_context = evt.target.value;
                },
                runQuery() {
                    let app = this;
                    let ao  = new EasyAjax('/admin/entity/run');
                    ao.add('context',$('#'+this.elements.context).val()).add('query',$(this.query_text).val()).add('rows',this.query.rows).add('page',this.query.page).then((response) => {
                        app.tabs.tabClick(3);
                        let rows     = JSON.parse(response);
                        let headers  = [];
                        for (var i in rows[0]) {
                            headers[headers.length] = i;
                        }
                        app.query.headers      = headers;
                        app.query.resultset    = rows;
                        app.queryPagination(ao.getPagination());

                        
                    }).post();                    
                },
                saveQuery() {
                    (new EasyAjax('/admin/entity/save')).add('window_id',this.window_id).add('tab_id',this.tab_id).add('query',$('#'+this.query_text).val()).then((response) => {
                        console.log(response);
                    }).post();
                },
		editQueryRow(id) {
                    let app      = this;                    
                    if (this.edit_context) {
                        app.edit.id = id;
                        app.tabs.tabClick(4);
                        (new EasyAjax('/admin/entity/loadrow')).add('id',id).add('entity',this.edit_context).then((response) => {
                            app.query.edit.row = JSON.parse(response);
                            //now set the form intercept
                            //Form.intercept(Form Reference,MongoDB ID,optional URL or just FALSE,Dynamic WindowID to Close After Saving);
                            //Form.intercept($('#'+app.edit.form).get(),null,'/admin/entity/updaterow',null);                        
                        }).post();		
                    } else {
                        alert('You must set the context by choosing the entity up in the top right corner that this applies to');
                    }
		},                
                cleanup() {
                    //maybe do something?
                }
            }          
        });
        Humble.admin['entity']['{{ window_id }}_{{ tab_id }}'].mount(entity_area);
        /*win._close(() => {
            alert('closing!');
            //Humble.admin['entity']['{{ window_id }}_{{ tab_id }}'].unmount();
        });*/
    })(Desktop.window.list['{{ window_id }}']);
</script>
