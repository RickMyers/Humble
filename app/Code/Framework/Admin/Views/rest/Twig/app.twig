<script type="text/javascript">
    ((win)=>{
        Humble.admin['rest_client'] = (!Humble.admin['rest_client']) ? {} : Humble.admin['rest_client'];
        Humble.admin['rest_client'] = Vue.createApp({
            template:   Humble.template('admin',"rest/client",true),
            app:        null,
            data() {
                return {
                    namespace: false,
                    controller: false,
                    action: false,
                    arguments: {},
                    namespaces: {},
                    controllers: {},
                    actions: {}
                }
            },
            mounted() {
                //alert('mounted');
                new EasyEdits('/edits/admin/restclient','rest-client');
                win.resize(()=>{ 
                   $('#rest_client_body').height(win.content.height() - $('#rest_client_header').height() - $('#rest_client_footer').height()); 
                });
                let app = this;
                (new EasyAjax('/admin/rest/namespaces')).then((response) => {
                    app.namespaces = JSON.parse(response);
                }).get();
            },
            methods: {
                fetchControllers(event) {
                    let app = this;
                    this.namespace = event.target.value;
                    (new EasyAjax('/admin/rest/controllers')).add('namespace',this.namespace).then((response) => {
                       app.controllers = JSON.parse(response); 
                    }).get();
                },
                fetchControllerActions(event) {
                    let app = this;
                    this.controller = event.target.value;
                    (new EasyAjax('/admin/rest/actions')).add('namespace',this.namespace).add('controller',this.controller).then((response) => {
                        app.actions = JSON.parse(response);
                    }).get();
                },
                fetchActionParameters(event) {
                    let app = this;
                    this.action = event.target.value;
                    (new EasyAjax('/admin/rest/parameters')).add('namespace',this.namespace).add('controller',this.controller).add('action',this.action).then((response) => {
                        app.arguments = JSON.parse(response);
                    }).get();
                }
            }
        });
        Humble.admin['rest_client'].mount('#'+win.content.id);
    })(Desktop.window.list['{{ window_id }}']);
</script> 